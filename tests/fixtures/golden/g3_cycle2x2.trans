# zero-empty-cell cycle rotation (design 3.4b, proposition 2)
legal   l ; l ; l ; l                    # everyone lifts
illegal m 0 1 ; w ; w ; w                # partial rotation: R1 vertex
legal   m 0 1 ; m 1 1 ; m 0 0 ; m 1 0    # full CW rotation, zero empty cells
legal   d ; d ; d ; d                    # ground everything (b0 at goal)
